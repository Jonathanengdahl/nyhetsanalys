# Copy to .env.local and fill in. Never commit real values.

# Public base URL of the site, without trailing slash.
SITE_URL=http://localhost:3000

# "true" allows search engines to index the site. Anything else (default)
# sends "noindex, nofollow" as meta tag and X-Robots-Tag header.
SITE_INDEXABLE=false

# Supabase (from step 1b)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AI chat (Claude API). Without a key the chat says it is not switched on.
ANTHROPIC_API_KEY=
# Optional key for the daily visitor pseudonym. Falls back to SUPABASE_SECRET_KEY.
CHAT_SECRET=
# Local testing only: "1" answers with a fixed test text instead of calling the API.
# Ignored on Vercel.
CHAT_MOCK=

# Later phases
CRON_SECRET=
